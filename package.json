{
  "name": "hisab-ghar",
  "version": "5.10.15",
  "description": "Hisab Ghar Desktop Application",
  "main": "electron/main.js",
  "scripts": {
    "build": "npm run frontend:build && npm run backend:build",
    "frontend:build": "node update-version.js && cd frontend && npm run build",
    "backend:build": "cd backend && npx prisma generate && node -e \"require('fs').readdirSync('node_modules/.prisma/client').filter(f=>f.includes('.tmp')).forEach(f=>require('fs').unlinkSync('node_modules/.prisma/client/'+f))\"",
    "build:custom": "npm run build && npx electron-builder --win --publish=never --config.directories.output=build-output --config.win.artifactName=Hisab-Ghar-Setup-${version}.${ext}",
    "test": "vitest --run"
  },
  "build": {
    "appId": "com.hisabghar.desktop",
    "productName": "Hisab Ghar",
    "asarUnpack": [
      "**\\*.{node,dll}"
    ],
    "compression": "normal",
    "directories": {
      "output": "dist",
      "buildResources": "assets"
    },
    "files": [
      "electron/**/*",
      "frontend/dist/**/*",
      "scripts/**/*",
      "setup-database.bat",
      "installer.nsh",
      "!backend",
      "!**/node_modules/*/{CHANGELOG.md,README.md,README,readme.md,readme}",
      "!**/node_modules/*/{test,__tests__,tests,powered-test,example,examples}",
      "!**/node_modules/*.d.ts",
      "!**/node_modules/.bin",
      "!**/*.{iml,o,hprof,orig,pyc,pyo,rbc,swp,csproj,sln,xproj}",
      "!.editorconfig",
      "!**/._*",
      "!**/{.DS_Store,.git,.hg,.svn,CVS,RCS,SCCS,.gitignore,.gitattributes}",
      "!**/{__pycache__,thumbs.db,.flowconfig,.idea,.vs,.nyc_output}",
      "!**/{appveyor.yml,.travis.yml,circle.yml}",
      "!**/{npm-debug.log,yarn.lock,.yarn-integrity,.yarn-metadata.json}"
    ],
    "extraResources": [
      {
        "from": "backend",
        "to": "backend",
        "filter": [
          "**/*",
          "!node_modules/.cache/**",
          "!node_modules/prisma/**",
          "!node_modules/@prisma/engines/**",
          "!node_modules/.prisma/client/*.tmp*",
          "!node_modules/.package-lock.json",
          "!**/*.md",
          "!**/*.map",
          "!**/test/**",
          "!**/tests/**",
          "!**/docs/**",
          "!prisma/migrations/**",
          "!prisma/inventory.db",
          "!*.sql",
          "!seed-demo-data.js",
          "!update-demo-license.js",
          "!create-super-admin.js",
          "!run-migration.js",
          "!run-seed.js",
          "!migrate-logo.js",
          "!.env.*",
          "!.gitignore"
        ]
      },
      {
        "from": "frontend/dist",
        "to": "frontend/dist"
      }
    ],
    "win": {
      "target": "nsis",
      "icon": "assets/icon.png",
      "publisherName": "Hisab Ghar",
      "verifyUpdateCodeSignature": false,
      "requestedExecutionLevel": "asInvoker",
      "artifactName": "Hisab-Ghar-Setup-${version}.${ext}",
      "executableName": "HisabGhar"
    },
    "mac": {
      "target": "dmg",
      "icon": "assets/icon.icns"
    },
    "linux": {
      "target": "AppImage",
      "icon": "assets/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "allowElevation": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "runAfterFinish": false,
      "include": "installer.nsh",
      "installerLanguages": [
        "en"
      ],
      "differentialPackage": false,
      "deleteAppDataOnUninstall": false,
      "displayLanguageSelector": false,
      "warningsAsErrors": false,
      "unicode": true,
      "perMachine": false,
      "packElevateHelper": false
    },
    "publish": {
      "provider": "github",
      "owner": "fareedjaved203",
      "repo": "inventory-desktop",
      "releaseType": "release"
    }
  },
  "author": "Hisab Ghar",
  "repository": {
    "type": "git",
    "url": "https://github.com/fareedjaved203/inventory-desktop.git"
  },
  "dependencies": {
    "electron-updater": "^6.1.7"
  },
  "devDependencies": {
    "electron": "^28.0.0",
    "electron-builder": "^24.9.1",
    "vitest": "^4.1.2"
  }
}
