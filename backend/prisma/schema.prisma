generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
}

model Product {
  id                String             @id @default(uuid())
  name              String
  description       String
  price             Decimal?
  purchasePrice     Decimal?           @default(0)
  perUnitPurchasePrice Decimal?        @default(0)
  sku               String?
  quantity          Decimal
  damagedQuantity   Decimal            @default(0)
  lowStockThreshold Decimal            @default(10)
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  unit              String             @default("pcs")
  userId            String
  isRawMaterial     Boolean            @default(false)
  retailPrice       Decimal?
  wholesalePrice    Decimal?
  unitValue         Decimal?
  categoryId        String?
  image             String?
  BulkPurchaseItem  BulkPurchaseItem[]
  expenses          Expense[]
  SaleItem          SaleItem[]
  SaleReturnItem    SaleReturnItem[]
  recipe            Recipe?
  recipeIngredients RecipeItem[] @relation("RecipeRawMaterial")
  category          Category?          @relation(fields: [categoryId], references: [id])
  bookingRefreshments BookingRefreshment[]

  @@unique([userId, name])
  @@index([userId])
  @@index([userId, name])
  @@index([userId, quantity])
  @@index([userId, createdAt])
  @@index([categoryId])
}

model Sale {
  id                  String       @id @default(uuid())
  billNumber          String       @unique
  totalAmount         Decimal
  originalTotalAmount Decimal?
  discount            Decimal      @default(0)
  paidAmount          Decimal      @default(0)
  saleDate            DateTime     @default(now())
  contactId           String?
  employeeId          String?
  carNumber           String?
  loadingDate         DateTime?
  arrivalDate         DateTime?
  description         String?
  transportCost       Decimal?
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt
  userId              String
  contact             Contact?     @relation(fields: [contactId], references: [id])
  employee            Employee?    @relation(fields: [employeeId], references: [id])
  items               SaleItem[]
  returns             SaleReturn[]
  auditTrail          AuditTrail[]

  @@index([userId])
  @@index([userId, saleDate])
  @@index([userId, createdAt])
  @@index([contactId])
  @@index([employeeId])
}

model SaleItem {
  id            String   @id @default(uuid())
  quantity      Decimal
  price         Decimal
  purchasePrice Decimal  @default(0)
  saleId        String
  productId     String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  priceType     String   @default("retail")
  product       Product  @relation(fields: [productId], references: [id])
  sale          Sale     @relation(fields: [saleId], references: [id])
}

model Contact {
  id               String            @id @default(uuid())
  name             String
  address          String?
  phoneNumber      String
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  userId           String
  contactType      String            @default("customer")
  purchases        BulkPurchase[]
  expenses         Expense[]
  loanTransactions LoanTransaction[]
  sales            Sale[]

  @@index([userId])
  @@index([userId, name])
  @@index([phoneNumber])
  @@index([userId, contactType])
}

model BulkPurchase {
  id            String             @id @default(uuid())
  invoiceNumber String?            @unique
  totalAmount   Decimal
  paidAmount    Decimal
  purchaseDate  DateTime           @default(now())
  description   String?
  contactId     String
  carNumber     String?
  transportCost Decimal?
  loadingDate   DateTime?
  arrivalDate   DateTime?
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
  userId        String
  discount      Decimal            @default(0)
  contact       Contact            @relation(fields: [contactId], references: [id])
  items         BulkPurchaseItem[]
  auditTrail    AuditTrail[]

  @@index([userId])
  @@index([contactId])
}

model BulkPurchaseItem {
  id             String       @id @default(uuid())
  quantity       Decimal
  purchasePrice  Decimal
  bulkPurchaseId String
  productId      String
  isTotalCostItem Boolean     @default(false)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  bulkPurchase   BulkPurchase @relation(fields: [bulkPurchaseId], references: [id])
  product        Product      @relation(fields: [productId], references: [id])
}

model SaleReturn {
  id           String           @id @default(uuid())
  returnNumber String           @unique
  totalAmount  Decimal
  returnDate   DateTime         @default(now())
  reason       String?
  refundAmount Decimal         @default(0)
  refundPaid   Boolean          @default(false)
  refundDate   DateTime?
  saleId       String
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  userId       String
  sale         Sale             @relation(fields: [saleId], references: [id])
  items        SaleReturnItem[]

  @@index([userId])
  @@index([saleId])
}

model SaleReturnItem {
  id           String     @id @default(uuid())
  quantity     Decimal
  price        Decimal
  saleReturnId String
  productId    String
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  product      Product    @relation(fields: [productId], references: [id])
  saleReturn   SaleReturn @relation(fields: [saleReturnId], references: [id])
}

model LoanTransaction {
  id          String   @id @default(uuid())
  amount      Decimal
  type        String
  description String?
  date        DateTime @default(now())
  contactId   String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  userId      String
  contact     Contact  @relation(fields: [contactId], references: [id])

  @@index([userId])
  @@index([contactId])
}

model DriveSettings {
  id                String   @id @default(uuid())
  serviceAccountKey String
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model License {
  id                String   @id @default(uuid())
  userId            String   @unique
  licenseKey        String
  deviceFingerprint String
  expiry            BigInt
  duration          String?
  activatedAt       DateTime @default(now())
  isTrial           Boolean  @default(false)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([userId])
}

model User {
  id           String    @id @default(uuid())
  email        String    @unique
  password     String
  resetOtp     String?
  otpExpiry    DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  companyName  String?
  role         String?   @default("admin")
  trialEndDate DateTime?

  @@index([email])
  @@index([role])
}

model ShopSettings {
  id               String   @id @default(uuid())
  email            String
  shopName         String
  shopDescription  String?
  shopDescription2 String?
  userName1        String
  userPhone1       String
  userName2        String?
  userPhone2       String?
  userName3        String?
  userPhone3       String?
  brand1           String?
  brand1Registered Boolean  @default(false)
  brand2           String?
  brand2Registered Boolean  @default(false)
  brand3           String?
  brand3Registered Boolean  @default(false)
  logo             String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  userId           String

  @@index([userId])
}

model Branch {
  id        String     @id @default(uuid())
  name      String     @unique
  code      String     @unique
  location  String
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  userId    String
  employees Employee[]

  @@index([userId])
}

model Employee {
  id          String   @id @default(uuid())
  firstName   String
  lastName    String
  phone       String
  email       String   @unique
  password    String
  permissions String
  branchId    String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  userId      String
  branch      Branch   @relation(fields: [branchId], references: [id])
  sales       Sale[]

  @@index([userId])
  @@index([email])
  @@index([branchId])
}

model Expense {
  id            String   @id @default(uuid())
  amount        Decimal
  date          DateTime @default(now())
  category      String
  description   String?
  paymentMethod String?
  receiptNumber String?
  contactId     String?
  userId        String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  productId     String?
  contact       Contact? @relation(fields: [contactId], references: [id])
  product       Product? @relation(fields: [productId], references: [id])

  @@index([userId])
  @@index([userId, date])
  @@index([contactId])
  @@index([productId])
}

model Recipe {
  id            String         @id @default(uuid())
  name          String
  description   String?
  productId     String         @unique
  userId        String
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  product       Product        @relation(fields: [productId], references: [id])
  ingredients   RecipeItem[]
  manufacturing Manufacturing[]

  @@index([userId])
  @@index([userId, name])
}

model RecipeItem {
  id            String  @id @default(uuid())
  recipeId      String
  rawMaterialId String
  quantity      Decimal
  unit          String  @default("pcs")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  recipe        Recipe  @relation(fields: [recipeId], references: [id])
  rawMaterial   Product @relation("RecipeRawMaterial", fields: [rawMaterialId], references: [id])

  @@index([recipeId])
  @@index([rawMaterialId])
}

model Manufacturing {
  id               String   @id @default(uuid())
  recipeId         String
  quantityProduced   Decimal
  manufacturingCost  Decimal  @default(0)
  productionDate   DateTime @default(now())
  notes            String?
  userId           String
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  recipe           Recipe   @relation(fields: [recipeId], references: [id])

  @@index([userId])
  @@index([recipeId])
  @@index([userId, productionDate])
}

model Category {
  id          String    @id @default(uuid())
  name        String
  description String?
  color       String?   @default("#3B82F6")
  icon        String?   @default("📦")
  userId      String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  products    Product[]

  @@unique([userId, name])
  @@index([userId])
  @@index([userId, name])
}

model AuditTrail {
  id          String   @id @default(uuid())
  tableName   String
  recordId    String
  fieldName   String
  oldValue    String?
  newValue    String?
  description String?
  changedAt   DateTime @default(now())
  changedBy   String   @default("system")
  saleId      String?
  purchaseId  String?
  sale        Sale?    @relation(fields: [saleId], references: [id], onDelete: Cascade)
  purchase    BulkPurchase? @relation(fields: [purchaseId], references: [id], onDelete: Cascade)

  @@index([tableName, recordId])
  @@index([changedAt])
  @@index([saleId])
  @@index([purchaseId])
}

model GameTable {
  id          String        @id @default(uuid())
  name        String
  tableType   String        @default("snooker")
  isAvailable Boolean       @default(true)
  userId      String
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  bookings    GameBooking[]

  @@index([userId])
  @@index([userId, isAvailable])
}

model GameBooking {
  id          String    @id @default(uuid())
  tableId     String
  memberId    String?
  member2Id   String?
  player1Name String
  player1Phone String?
  player2Name String?
  player2Phone String?
  chargeType  String
  charges     Decimal
  player1Charges Decimal @default(0)
  player2Charges Decimal @default(0)
  expectedDuration String?
  checkInTime DateTime  @default(now())
  checkOutTime DateTime?
  gamesPlayed Int?      @default(0)
  totalAmount Decimal?  @default(0)
  paymentMethod String? @default("cash")
  isPaid      Boolean   @default(false)
  userId      String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  table       GameTable @relation(fields: [tableId], references: [id], onDelete: Cascade)
  member      Member?   @relation("Player1Member", fields: [memberId], references: [id])
  member2     Member?   @relation("Player2Member", fields: [member2Id], references: [id])
  refreshments BookingRefreshment[]
  playerBills PlayerBill[]

  @@index([userId])
  @@index([tableId])
  @@index([memberId])
  @@index([member2Id])
  @@index([userId, checkInTime])
}

model BookingRefreshment {
  id          String      @id @default(uuid())
  bookingId   String
  playerName  String
  playerBillId String?
  productId   String
  productName String
  quantity    Decimal
  price       Decimal
  totalAmount Decimal
  createdAt   DateTime    @default(now())
  booking     GameBooking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  playerBill  PlayerBill? @relation(fields: [playerBillId], references: [id])
  product     Product     @relation(fields: [productId], references: [id])

  @@index([bookingId])
  @@index([bookingId, playerName])
  @@index([playerBillId])
}

model PlayerBill {
  id             String      @id @default(uuid())
  bookingId      String
  memberId       String?
  playerName     String
  playerPhone    String?
  chargeType     String
  chargePerGame  Decimal     @default(0)
  gamesPlayed    Int         @default(0)
  totalAmount    Decimal     @default(0)
  paymentMethod  String?
  isPaid         Boolean     @default(false)
  checkoutTime   DateTime?
  userId         String
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
  booking        GameBooking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  member         Member?     @relation(fields: [memberId], references: [id])
  refreshments   BookingRefreshment[]

  @@index([bookingId])
  @@index([memberId])
  @@index([userId])
  @@index([isPaid])
}

model Member {
  id             String   @id @default(uuid())
  name           String
  email          String?
  phone          String
  cnic           String?
  membershipType String
  membershipPrice Decimal @default(0)
  totalGames     Int      @default(0)
  remainingGames Int      @default(0)
  perFrameCharge Decimal? @default(0)
  startDate      DateTime @default(now())
  expiryDate     DateTime
  lastResetDate  DateTime @default(now())
  isActive       Boolean  @default(true)
  userId         String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  bookingsAsPlayer1 GameBooking[] @relation("Player1Member")
  bookingsAsPlayer2 GameBooking[] @relation("Player2Member")
  playerBills    PlayerBill[]

  @@index([userId])
  @@index([userId, expiryDate])
  @@index([userId, isActive])
}

